# ============================================================
# web2api 环境变量样例 —— 复制为 .env 后按需修改
# docker compose up -d 会自动读取同目录 .env 文件
# ============================================================

# 对外暴露端口（宿主机端口:容器内 8800）
WEB2API_PORT=8800

# 种子 API Key（逗号分隔多个；启动后自动导入 Key 库，管理台可增删）
WEB2API_API_KEYS=sk-web2api

# 默认引擎路由：auto | a | b
WEB2API_DEFAULT_ENGINE=auto

# 代理地址（引擎A 访问 Google；如 http://host.docker.internal:7890）
# 容器内访问宿主机代理用 host.docker.internal（Docker Desktop）或宿主机内网 IP
WEB2API_PROXY=

# 面板升级目标；首次启用参见 docker/README.md
WEB2API_UPGRADE_IMAGE=ghcr.io/plunjoin/web2api:latest
# 私有镜像仓库时填写，公开镜像留空。不要将真实凭据提交到 Git。
WEB2API_UPGRADE_REGISTRY_USER=
WEB2API_UPGRADE_REGISTRY_PASSWORD=
